<Window x:Class="SilNet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SilNet" Width="1030" Height="820" MinWidth="920" MinHeight="740" Background="#F5F7FC" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources>
  <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1DA1F2" Offset="0"/><GradientStop Color="#2563EB" Offset="0.5"/><GradientStop Color="#3946D7" Offset="1"/></LinearGradientBrush>
  <Style x:Key="PowerButton" TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource BrandGradient}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PowerSurface" Background="{TemplateBinding Background}" CornerRadius="90"><StackPanel VerticalAlignment="Center"><Viewbox Width="41" Height="41" Margin="0,0,0,12"><Grid Width="40" Height="40"><Path Data="M 11,8 A 15,15 0 1 0 29,8" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M20,1 L20,18" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Viewbox><ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="18" TextElement.FontWeight="SemiBold" TextElement.Foreground="White"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerSurface" Property="BorderBrush" Value="#132E87"/><Setter TargetName="PowerSurface" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ServiceToggle" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Chip" Background="#F3F6FC" BorderBrush="#E2E9F4" BorderThickness="1" CornerRadius="10" Padding="11,9"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Tick" Text="+" Foreground="#8294AF" Margin="0,0,7,0" FontWeight="SemiBold"/><ContentPresenter TextElement.FontSize="12" TextElement.Foreground="#465D7C"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#EAF2FF"/><Setter TargetName="Chip" Property="BorderBrush" Value="#B8D2FF"/><Setter TargetName="Tick" Property="Text" Value="✓"/><Setter TargetName="Tick" Property="Foreground" Value="#2563EB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#F5F7FC"><Grid x:Name="Shell" TextElement.Foreground="#172B46" Margin="32,24,32,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="Assets/SilNet.png" Width="52" Height="52" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="SilNet" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="Bold"/></StackPanel><TextBlock Text="Ücretsiz bağlantı yardımcın" FontSize="11" Foreground="#7C8CA5" Margin="1,1,0,0"/></StackPanel></StackPanel><Button x:Name="UpdatePill" Grid.Column="1" Content="Güncellemeler  ↗" Click="Update_Click" VerticalAlignment="Center" Padding="14,9" FontSize="12"/></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,23"><Border BorderBrush="#E0E7F2" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/><StackPanel Orientation="Horizontal"><Button x:Name="HomeNav" Tag="home" Content="Bağlantı" Click="Navigate" Background="#E7EFFF" BorderThickness="0" Foreground="#2563EB" Margin="0,0,8,10" Padding="20,10"/><Button x:Name="TargetsNav" Tag="targets" Content="Uygulamalar" Click="Navigate" Background="Transparent" BorderThickness="0" Margin="0,0,8,10" Padding="20,10"/><Button x:Name="DiagnosticsNav" Tag="diagnostics" Content="Tanılama" Click="Navigate" Background="Transparent" BorderThickness="0" Margin="0,0,8,10" Padding="20,10"/><Button x:Name="SettingsNav" Tag="settings" Content="Ayarlar" Click="Navigate" Background="Transparent" BorderThickness="0" Margin="0,0,8,10" Padding="20,10"/></StackPanel><TextBlock x:Name="NetworkLabel" Text="Yerel bağlantı" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#7C8CA5" Margin="0,0,4,10"/></Grid>
  <Border x:Name="FeedbackBanner" Grid.Row="2" Background="#EAF2FF" CornerRadius="12" Padding="15,12" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="12" Foreground="#2A5DA7"/></Border><ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
   <Grid>
    <StackPanel x:Name="HomePage">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="24,24,24,20"><StackPanel HorizontalAlignment="Stretch">
       <Border x:Name="StateChip" CornerRadius="15" Background="#EEF2F8" Padding="12,6" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#91A0B7" Margin="0,0,7,0"/><TextBlock x:Name="StateLabel" Text="BAĞLANTI KAPALI" Foreground="#6B7E98" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
       <TextBlock x:Name="HeroTitle" Text="Bir dokunuşla başla." FontSize="26" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8"/>
       <TextBlock x:Name="HeroDescription" Text="Sağlayıcını seç. SilNet uygun yöntemi&#x0a;bu bağlantıda deneyerek bulsun." TextAlignment="Center" Style="{StaticResource Caption}" FontSize="12"/>
       <Grid Width="190" Height="190" Margin="0,12,0,10"><Ellipse x:Name="PowerHalo" Fill="#E6EFFF" Opacity="0.5"/><Ellipse Width="174" Height="174" Stroke="#DFEAFE" StrokeThickness="1"/><Ellipse Width="160" Height="160" Fill="#E6EFFF"/><Button x:Name="ConnectButton" Style="{StaticResource PowerButton}" Width="146" Height="146" Content="Bağlan" Click="Connect_Click" AutomationProperties.Name="SilNet bağlantısını başlat veya durdur"/></Grid>
       <TextBlock x:Name="ConnectionHint" Text="Başlatırken Windows izin ister." TextAlignment="Center" Foreground="#8594AC" FontSize="11"/>
       <Button x:Name="VerifyButton" Content="Erişimi kontrol et  →" Click="Test_Click" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="12" Padding="12,10" Margin="0,2,0,0"/>
      </StackPanel></Border>
      <StackPanel Grid.Column="2">
       <Border Style="{StaticResource Card}" Padding="20"><StackPanel>
        <TextBlock Text="İnternet sağlayıcın" FontWeight="SemiBold" FontSize="15"/>
        <ComboBox x:Name="ProviderPicker" Margin="0,14,0,5" SelectionChanged="Provider_Changed" AutomationProperties.Name="Türkiye internet sağlayıcısı"/>
        <TextBlock x:Name="ProviderDetail" Text="En uygun yöntemi test ederek bul" FontSize="11" Foreground="#8392A9" Margin="2,3,0,10"/>
        <CheckBox x:Name="AutomaticCheck" Content="Uygun yöntemi otomatik bul" IsChecked="True" Checked="Automatic_Changed" Unchecked="Automatic_Changed" Foreground="#30496B" FontSize="12"/>
        <TextBlock Text="Önce bu ağda son çalışan ayarı dener." Style="{StaticResource Caption}" FontSize="11" Margin="20,4,0,10"/>
        <Expander Header="Yöntemi elle seç" Foreground="#73839B" FontSize="11"><StackPanel Margin="0,10,0,3"><ComboBox x:Name="ProfilePicker" SelectionChanged="Profile_Changed" AutomationProperties.Name="Bağlantı yöntemi"/><TextBlock x:Name="ProfileDetail" Style="{StaticResource Caption}" FontSize="11" Margin="1,8,0,0"/></StackPanel></Expander>
        <Border Height="1" Background="#EBEFF6" Margin="0,12,0,11"/>
        <TextBlock Text="Uygulamalarını seç" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel><CheckBox x:Name="DiscordChip" AutomationProperties.Name="Discord" Tag="discord" Style="{StaticResource ServiceToggle}" Checked="Service_Changed" Unchecked="Service_Changed"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource DiscordLogo}" Fill="#5865F2" Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Discord" FontSize="12" VerticalAlignment="Center"/></StackPanel></CheckBox><CheckBox x:Name="RobloxChip" AutomationProperties.Name="Roblox" Tag="roblox" Style="{StaticResource ServiceToggle}" Checked="Service_Changed" Unchecked="Service_Changed"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource RobloxLogo}" Fill="#172B46" Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Roblox" FontSize="12" VerticalAlignment="Center"/></StackPanel></CheckBox><CheckBox x:Name="WattpadChip" AutomationProperties.Name="Wattpad" Tag="wattpad" Style="{StaticResource ServiceToggle}" Checked="Service_Changed" Unchecked="Service_Changed"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource WattpadLogo}" Fill="#FF6122" Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Wattpad" FontSize="12" VerticalAlignment="Center"/></StackPanel></CheckBox></WrapPanel>
        <Button x:Name="MoreAppsButton" Content="Tüm uygulamalar (14)  →" Click="MoreApps_Click" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="11" HorizontalAlignment="Left" Padding="10,8" MinHeight="34"/>
       </StackPanel></Border>
       <Border CornerRadius="15" Background="#EAF2FF" BorderBrush="#DCE9FF" BorderThickness="1" Padding="18,11" Margin="0,14,0,0"><StackPanel><TextBlock Text="Bu bağlantıyı hatırlar." Foreground="#2D60B2" FontSize="12" FontWeight="SemiBold"/><TextBlock LineHeight="17" x:Name="MemoryLabel" Text="Henüz bu ağda doğrulanmış bir ayar yok.&#x0a;Sonuçlar yalnızca cihazında saklanır." Style="{StaticResource Caption}" FontSize="11" Foreground="#6881A6" Margin="0,5,0,0"/></StackPanel></Border>
      </StackPanel>
     </Grid>
     <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MOTOR" FontSize="9" FontWeight="SemiBold" Foreground="#8797AF"/><TextBlock x:Name="MotorStatus" Text="Kapalı" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SON ERİŞİM TESTİ" FontSize="9" FontWeight="SemiBold" Foreground="#8797AF"/><TextBlock x:Name="TestStatus" Text="Henüz yapılmadı" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AĞ AYARLARI" FontSize="9" FontWeight="SemiBold" Foreground="#8797AF"/><TextBlock x:Name="DnsStatus" Text="Kalıcı DNS ayarın korunur" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Grid></Border>
     <TextBlock Text="IP adresini gizlemez. HTTPS testi ses gecikmesini ölçmez. QUIC isteğe bağlıdır." LineHeight="14" Style="{StaticResource Caption}" FontSize="10" TextAlignment="Center" Margin="0,9,0,0"/>
    </StackPanel>
    <StackPanel x:Name="TargetsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="Uygulamalarını ve sitelerini yönet." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Hazır uygulama seçimini aç veya kendi alan adlarını ekle. Değiştirmek için önce bağlantıyı durdur." Style="{StaticResource Caption}" Margin="0,10,0,20"/><Button Content="14 uygulamadan seç  →" Click="MoreApps_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,0,0,20"/><Expander Header="Alan adlarını elle düzenle" Foreground="#64758B"><StackPanel Margin="0,16,0,0"><TextBox x:Name="HostsEditor" AcceptsReturn="True" Height="315" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="14" AutomationProperties.Name="Hedef siteler"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="SaveHostsButton" Content="Siteleri kaydet" Style="{StaticResource Primary}" Click="SaveHosts_Click"/><Button x:Name="DefaultHostsButton" Content="Varsayılanları getir" Click="Defaults_Click" Margin="12,0,0,0"/></StackPanel></StackPanel></Expander></StackPanel></Border></StackPanel>
    <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><StackPanel><TextBlock Text="Tahmin etme. Kontrol et." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Süreler DNS, bağlantı ve HTTP yanıtını içerir. Discord ses / oyun pingi ölçümü değildir." Style="{StaticResource Caption}" Margin="0,10,0,0" MaxWidth="580" HorizontalAlignment="Left"/></StackPanel><Button x:Name="DiagTestButton" Content="Testi başlat" Click="Test_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid><ItemsControl x:Name="ResultsList" Margin="0,15,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E8EDF5" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Host}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TotalLabel}" ToolTip="{Binding TimingInfo}" FontSize="12" Foreground="#64758B" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,17,0,0"><StackPanel><Grid><TextBlock Text="Oturum günlüğü" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Klasörü aç" Click="OpenLogs_Click" Padding="12,6" FontSize="11"/><Button Content="Kopyala" Click="CopyLog_Click" Padding="12,6" FontSize="11" Margin="8,0,0,0"/></StackPanel></Grid><TextBlock Text="Günlüklerde alan adları bulunabilir. Paylaşmadan önce incele." Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,12"/><TextBox x:Name="LogBox" IsReadOnly="True" Height="245" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#F8FAFE"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="SilNet, senin kontrolünde." FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Text="SilNet 0.2.0 · Windows x64" Foreground="#2563EB" FontSize="12" Margin="0,10,0,23"/><CheckBox x:Name="AutoUpdatesCheck" Content="Açılışta yeni sürümleri kontrol et" IsChecked="True" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed" FontSize="13"/><TextBlock Text="GitHub’daki resmî SilNet yayınlarını kontrol eder. Yeni sürüm varsa haber verir; iznin olmadan kurulum yapmaz." Style="{StaticResource Caption}" FontSize="12" Margin="20,8,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Güncellemeleri kontrol et" Click="Update_Click"/><Button Content="GitHub’ı aç  ↗" Click="Github_Click" Margin="10,0,0,0"/></StackPanel><Border Height="1" Background="#E7EDF6" Margin="0,25"/><CheckBox x:Name="SecureDnsCheck" Content="Seçili sitelerde şifreli DNS kullan" IsChecked="True" Checked="SecureDns_Changed" Unchecked="SecureDns_Changed" FontSize="13"/><TextBlock Text="DNS engelini Google / Cloudflare DoH ile aşmayı dener. Yalnızca seçtiğin alan adlarının UDP DNS sorguları geçici olarak işlenir; kalıcı Windows DNS ayarın değişmez." Style="{StaticResource Caption}" FontSize="12" Margin="20,8,0,20"/><CheckBox x:Name="QuicCheck" Content="QUIC uyumluluğunu aç (UDP 443)" Checked="Quic_Changed" Unchecked="Quic_Changed" FontSize="13"/><TextBlock Text="Varsayılan kapalıdır; SilNet UDP 443 trafiğini işlemez. Gereken sitelerde bu seçenekle QUIC profili de denenebilir. Discord ses gecikmesini düşürme garantisi vermez." Style="{StaticResource Caption}" FontSize="12" Margin="20,8,0,20"/><Button Content="Kurulum sihirbazını aç" Click="Setup_Click" HorizontalAlignment="Left"/><Border Height="1" Background="#E7EDF6" Margin="0,25"/><TextBlock Text="Ücretsiz. Hesap ve abonelik gerekmez." FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Trafiğin bize ait bir sunucudan geçmez. Sağlayıcı seçimin ve çalışan ayarlar yalnızca cihazında tutulur. DPI aşımı IP adresini gizlemez. Her ağda çalışması garanti edilmez." Style="{StaticResource Caption}" Margin="0,10,0,18"/><TextBlock Text="Motor ve bağlantı yöntemleri" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Zapret2 (bol-van) · WinDivert (basil00) · Cygwin&#x0a;Türkiye başlangıç profilleri SplitWire-Turkey önayarlarından uyarlanmıştır. Sağlayıcıların resmî ürünü değildir. Lisanslar ve kaynak arşivleri uygulama klasöründedir." Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="DNS, güvenlik duvarı ve otomatik başlangıç ayarları değiştirilmez. Windows yönetici izni bağlantı motoru için istenir. X düğmesi SilNet’i tepsiye küçültür. Tamamen kapatmak için tepsi menüsünden Çıkış’ı seç." Style="{StaticResource Caption}" FontSize="12" Margin="0,18,0,0"/><Border Height="1" Background="#E7EDF6" Margin="0,22"/><StackPanel Orientation="Horizontal"><Button Content="SilNet’i kaldır" Click="Uninstall_Click"/><Button Content="Ayarları temizle ve çık" Click="ResetExit_Click" Margin="10,0,0,0"/><Button Content="Çıkış" Click="Exit_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Kaldırıcı yalnızca SilNet dosyalarını kaldırır. Kişisel ayar ve günlük temizliği ayrıca seçilir. Ortak sürücüler silinmez." Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="4" Margin="0,16,0,0"><ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Foreground="#2563EB" Background="#E3EAF3" Visibility="Collapsed" Margin="0,0,0,11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Notice" Text="Hazır. Sağlayıcını seçip Bağlan’a basabilirsin." FontSize="11" Foreground="#7386A1" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="CancelButton" Content="İptal et" Click="Cancel_Click" Grid.Column="1" Visibility="Collapsed" Padding="12,6" Margin="12,0,0,0" FontSize="11"/></Grid></StackPanel>
 </Grid></Border>
</Window>

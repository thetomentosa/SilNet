<Window x:Class="SilNet.OnboardingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SilNet · İlk kurulum" Width="630" Height="700" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F5F7FC" ShowInTaskbar="False">
 <Border Background="#F5F7FC"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Image Source="Assets/SilNet.png" Width="46" Height="46" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SilNet" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="StepLabel" Text="İLK KURULUM · ADIM 1 / 3" FontSize="10" Foreground="#7B8DAA" Margin="0,4,0,0"/></StackPanel></StackPanel>
  <ProgressBar x:Name="StepProgress" Grid.Row="1" Minimum="0" Maximum="3" Value="1" Height="4" Foreground="#2563EB" Background="#DFE8F7" Margin="0,0,0,20"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><Grid ClipToBounds="True">
   <StackPanel x:Name="WelcomePage"><TextBlock Text="Bağlantını birlikte hazırlayalım." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Üç kısa adım. Hesap, abonelik veya ödeme gerekmez." Style="{StaticResource Caption}" Margin="0,13,0,22"/><Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="Sen seç, SilNet denesin." FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Sağlayıcına göre yöntemleri test eder ve bu bağlantıda çalışan son ayarı hatırlar." Style="{StaticResource Caption}" FontSize="12" Margin="0,9,0,20"/><TextBlock Text="DNS engellerini de kontrol eder." FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Seçili alan adlarının sorgularını geçici olarak Google / Cloudflare şifreli DNS üzerinden çözebilir. Windows DNS sunucun kalıcı olarak değiştirilmez." Style="{StaticResource Caption}" FontSize="12" Margin="0,9,0,20"/><TextBlock Text="Kapatınca tepside kalır." FontSize="16" FontWeight="SemiBold"/><TextBlock Text="X düğmesi pencereyi gizler. Tamamen çıkmak ve motoru durdurmak için sağ alttaki SilNet simgesinden Çıkış’ı seç." Style="{StaticResource Caption}" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border></StackPanel>
   <StackPanel x:Name="ChoicesPage" Visibility="Collapsed"><TextBlock Text="Sana göre ayarlayalım." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="İnternet sağlayıcın" FontWeight="SemiBold" Margin="0,15,0,8"/><ComboBox x:Name="ProviderChoice"/><TextBlock Text="Emin değilsen Otomatik seçili kalabilir." Style="{StaticResource Caption}" FontSize="11" Margin="1,5,0,14"/><TextBlock Text="Erişmek istediğin uygulamalar" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="DiscordChoice" Content="Discord" Margin="0,0,0,10" FontSize="14"/><CheckBox x:Name="RobloxChoice" Content="Roblox" Margin="0,0,0,10" FontSize="14"/><CheckBox x:Name="WattpadChoice" Content="Wattpad" Margin="0,0,0,18" FontSize="14"/><Button Content="Tüm uygulamalar (14)  →" Click="AllApps_Click" HorizontalAlignment="Left" Margin="0,0,0,10" FontSize="12" Padding="13,8"/><CheckBox x:Name="DnsChoice" Content="Seçili sitelerde şifreli DNS kullan" IsChecked="True" FontSize="13"/><TextBlock Text="Yalnızca seçili sitelerin UDP DNS sorguları işlenir. Diğer alan adları normal DNS yolunu kullanır." Style="{StaticResource Caption}" FontSize="11" Margin="20,6,0,0"/></StackPanel>
   <StackPanel x:Name="ReadyPage" Visibility="Collapsed"><TextBlock Text="Her şey hazır." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Son bir göz atalım." Style="{StaticResource Caption}" Margin="0,10,0,22"/><Border Style="{StaticResource Card}" Padding="24"><StackPanel><TextBlock Text="SEÇTİĞİN AYARLAR" FontSize="10" Foreground="#7B8DAA"/><TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="15" LineHeight="29" Margin="0,14,0,0"/></StackPanel></Border><TextBlock Text="Bağlan’a bastığında Windows yönetici izni isteyebilir. Her sağlayıcıda çalışma garantisi yoktur; sonuçlar bağlantı testiyle doğrulanır." Style="{StaticResource Caption}" FontSize="12" Margin="0,20,0,22"/><CheckBox x:Name="ConnectChoice" Content="Bitince bağlantıyı başlat" FontSize="13"/></StackPanel>
  </Grid></ScrollViewer>
  <StackPanel Grid.Row="3" Margin="0,20,0,0"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B44559" FontSize="12" Margin="0,0,0,12"/><Grid><StackPanel Orientation="Horizontal"><Button x:Name="BackButton" Content="Geri" Click="Back_Click" Visibility="Collapsed"/><Button Content="Şimdilik atla" Click="Skip_Click" Background="Transparent" BorderThickness="0" Foreground="#6E82A0" Margin="8,0,0,0"/></StackPanel><Button x:Name="NextButton" Content="Başlayalım  →" Click="Next_Click" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid></StackPanel>
 </Grid></Border>
</Window>

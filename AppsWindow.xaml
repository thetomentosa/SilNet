<Window x:Class="SilNet.AppsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SilNet · Uygulamalar" Width="790" Height="740" MinWidth="700" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F7FC">
 <Border Background="#F5F7FC"><Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="4,0,0,20"><TextBlock Text="Uygulamalarını seç." FontSize="27" FontWeight="SemiBold"/><TextBlock Text="14 yaygın hizmet. Dilediğini seç; erişim durumu bağlantına göre değişebilir." Style="{StaticResource Caption}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ChoicesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="Service_Checked" Unchecked="Service_Unchecked" Margin="4" Cursor="Hand" AutomationProperties.Name="{Binding Service.Name}"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border x:Name="Tile" Background="White" BorderBrush="#E1E8F4" BorderThickness="1" CornerRadius="14" Padding="16,12"><Grid MinHeight="45"><ContentPresenter/><TextBlock x:Name="Check" Text="+" Foreground="#93A2B9" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EAF2FF"/><Setter TargetName="Tile" Property="BorderBrush" Value="#98BCFF"/><Setter TargetName="Check" Property="Text" Value="✓"/><Setter TargetName="Check" Property="Foreground" Value="#2563EB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderThickness" Value="2"/><Setter TargetName="Tile" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding Service.Glyph}" Fill="{Binding Service.Color}" Width="23" Height="23" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="11,4,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Service.Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Service.Category}" FontSize="10" Foreground="#7C8DA7" Margin="0,5,0,0"/></StackPanel></Grid></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="4,17,4,0"><Border x:Name="EasterEgg" Background="#EAF2FF" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed"><TextBlock x:Name="EasterEggText" FontSize="12" Foreground="#35619F" TextWrapping="Wrap"/></Border><TextBlock Text="Web ve HTTPS trafiği hedeflenir; sesli görüşme, oyun içi bağlantı veya her uygulamanın bütün işlevleri garanti edilmez." Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,13"/><TextBlock x:Name="ErrorText" Foreground="#B44559" FontSize="12" Margin="0,0,0,10"/><Grid><Button Content="Vazgeç" Click="Cancel_Click" HorizontalAlignment="Left"/><Button Content="Seçimi kaydet" Click="Save_Click" HorizontalAlignment="Right" Style="{StaticResource Primary}"/></Grid></StackPanel>
 </Grid></Border>
</Window>

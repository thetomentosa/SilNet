<Window x:Class="SilNet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SilNet" Width="1030" Height="820" MinWidth="920" MinHeight="740" Background="#F5F7FC" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources>
  <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1DA1F2" Offset="0"/><GradientStop Color="#2563EB" Offset="0.5"/><GradientStop Color="#3946D7" Offset="1"/></LinearGradientBrush>
  <Style x:Key="PowerButton" TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource BrandGradient}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PowerSurface" Background="{TemplateBinding Background}" CornerRadius="90"><StackPanel VerticalAlignment="Center"><Viewbox Width="41" Height="41" Margin="0,0,0,12"><Grid Width="40" Height="40"><Path Data="M 11,8 A 15,15 0 1 0 29,8" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M20,1 L20,18" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Viewbox><ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="18" TextElement.FontWeight="SemiBold" TextElement.Foreground="White"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerSurface" Property="BorderBrush" Value="#132E87"/><Setter TargetName="PowerSurface" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ServiceToggle" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Chip" Background="#F3F6FC" BorderBrush="#E2E9F4" BorderThickness="1" CornerRadius="10" Padding="11,9"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Tick" Text="+" Foreground="#8294AF" Margin="0,0,7,0" FontWeight="SemiBold"/><ContentPresenter TextElement.FontSize="12" TextElement.Foreground="#465D7C"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#EAF2FF"/><Setter TargetName="Chip" Property="BorderBrush" Value="#B8D2FF"/><Setter TargetName="Tick" Property="Text" Value="✓"/><Setter TargetName="Tick" Property="Foreground" Value="#2563EB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#F5F7FC"><Grid TextElement.Foreground="#172B46" Margin="32,24,32,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="Assets/SilNet.png" Width="52" Height="52" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="SilNet" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="Bold"/><Border CornerRadius="6" Background="#E9EFF9" Margin="10,6,0,4" Padding="7,3"><TextBlock Text="ÖNİZLEME" FontSize="9" Foreground="#6E80A0" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="Ücretsiz bağlantı yardımcın" FontSize="11" Foreground="#7C8CA5" Margin="1,1,0,0"/></StackPanel></StackPanel><Button x:Name="UpdatePill" Grid.Column="1" Content="Güncellemeler  ↗" Click="Update_Click" VerticalAlignment="Center" Padding="14,9" FontSize="12"/></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,23"><Border BorderBrush="#E0E7F2" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/><StackPanel Orientation="Horizontal"><Button x:Name="HomeNav" Tag="home" Content="Bağlantı" Click="Navigate" Background="#E7EFFF" BorderThickness="0" Foreground="#2563EB" Margin="0,0,8,10" Padding="20,10"/><Button x:Name="TargetsNav" Tag="targets" Content="Siteler" Click="Navigate" Background="Transparent" BorderThickness="0" Margin="0,0,8,10" Padding="20,10"/><Button x:Name="DiagnosticsNav" Tag="diagnostics" Content="Tanılama" Click="Navigate" Background="Transparent" BorderThickness="0" Margin="0,0,8,10" Padding="20,10"/><Button x:Name="SettingsNav" Tag="settings" Content="Ayarlar" Click="Navigate" Background="Transparent" BorderThickness="0" Margin="0,0,8,10" Padding="20,10"/></StackPanel><TextBlock x:Name="NetworkLabel" Text="Yerel bağlantı" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#7C8CA5" Margin="0,0,4,10"/></Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
   <Grid>
    <StackPanel x:Name="HomePage">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="24,24,24,20"><StackPanel HorizontalAlignment="Stretch">
       <Border x:Name="StateChip" CornerRadius="15" Background="#EEF2F8" Padding="12,6" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#91A0B7" Margin="0,0,7,0"/><TextBlock x:Name="StateLabel" Text="BAĞLANTI KAPALI" Foreground="#6B7E98" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
       <TextBlock x:Name="HeroTitle" Text="Bir dokunuşla başla." FontSize="26" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8"/>
       <TextBlock x:Name="HeroDescription" Text="Sağlayıcını seç. SilNet uygun yöntemi&#x0a;bu bağlantıda deneyerek bulsun." TextAlignment="Center" Style="{StaticResource Caption}" FontSize="12"/>
       <Grid Width="190" Height="190" Margin="0,12,0,10"><Ellipse Fill="#F3F7FF"/><Ellipse Width="174" Height="174" Stroke="#DFEAFE" StrokeThickness="1"/><Ellipse Width="160" Height="160" Fill="#E6EFFF"/><Button x:Name="ConnectButton" Style="{StaticResource PowerButton}" Width="146" Height="146" Content="Bağlan" Click="Connect_Click" AutomationProperties.Name="SilNet bağlantısını başlat veya durdur"/></Grid>
       <TextBlock x:Name="ConnectionHint" Text="Başlatırken Windows izin ister." TextAlignment="Center" Foreground="#8594AC" FontSize="11"/>
       <Button x:Name="VerifyButton" Content="Erişimi kontrol et  →" Click="Test_Click" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="12" Padding="12,10" Margin="0,2,0,0"/>
      </StackPanel></Border>
      <StackPanel Grid.Column="2">
       <Border Style="{StaticResource Card}" Padding="20"><StackPanel>
        <TextBlock Text="İnternet sağlayıcın" FontWeight="SemiBold" FontSize="15"/>
        <ComboBox x:Name="ProviderPicker" Margin="0,14,0,5" SelectionChanged="Provider_Changed" AutomationProperties.Name="Türkiye internet sağlayıcısı"/>
        <TextBlock x:Name="ProviderDetail" Text="En uygun yöntemi test ederek bul" FontSize="11" Foreground="#8392A9" Margin="2,3,0,10"/>
        <CheckBox x:Name="AutomaticCheck" Content="Uygun yöntemi otomatik bul" IsChecked="True" Checked="Automatic_Changed" Unchecked="Automatic_Changed" Foreground="#30496B" FontSize="12"/>
        <TextBlock Text="Önce bu ağda son çalışan ayarı dener." Style="{StaticResource Caption}" FontSize="11" Margin="20,4,0,10"/>
        <Expander Header="Yöntemi elle seç" Foreground="#73839B" FontSize="11"><StackPanel Margin="0,10,0,3"><ComboBox x:Name="ProfilePicker" SelectionChanged="Profile_Changed" AutomationProperties.Name="Bağlantı yöntemi"/><TextBlock x:Name="ProfileDetail" Style="{StaticResource Caption}" FontSize="11" Margin="1,8,0,0"/></StackPanel></Expander>
        <Border Height="1" Background="#EBEFF6" Margin="0,12,0,11"/>
        <TextBlock Text="Nerede kullanacaksın?" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel><CheckBox x:Name="DiscordChip" Content="Discord" Tag="discord" Style="{StaticResource ServiceToggle}" Checked="Service_Changed" Unchecked="Service_Changed"/><CheckBox x:Name="RobloxChip" Content="Roblox" Tag="roblox" Style="{StaticResource ServiceToggle}" Checked="Service_Changed" Unchecked="Service_Changed"/><CheckBox x:Name="YoutubeChip" Content="YouTube" Tag="youtube" Style="{StaticResource ServiceToggle}" Checked="Service_Changed" Unchecked="Service_Changed"/></WrapPanel>
        <TextBlock Text="Diğer alan adlarını Siteler’den ekleyebilirsin." Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/>
       </StackPanel></Border>
       <Border CornerRadius="15" Background="#EAF2FF" BorderBrush="#DCE9FF" BorderThickness="1" Padding="18,11" Margin="0,14,0,0"><StackPanel><TextBlock Text="Bu bağlantıyı hatırlar." Foreground="#2D60B2" FontSize="12" FontWeight="SemiBold"/><TextBlock LineHeight="17" x:Name="MemoryLabel" Text="Henüz bu ağda doğrulanmış bir ayar yok.&#x0a;Sonuçlar yalnızca cihazında saklanır." Style="{StaticResource Caption}" FontSize="11" Foreground="#6881A6" Margin="0,5,0,0"/></StackPanel></Border>
      </StackPanel>
     </Grid>
     <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MOTOR" FontSize="9" FontWeight="SemiBold" Foreground="#8797AF"/><TextBlock x:Name="MotorStatus" Text="Kapalı" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SON ERİŞİM TESTİ" FontSize="9" FontWeight="SemiBold" Foreground="#8797AF"/><TextBlock x:Name="TestStatus" Text="Henüz yapılmadı" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AĞ AYARLARI" FontSize="9" FontWeight="SemiBold" Foreground="#8797AF"/><TextBlock Text="DNS ayarların korunur" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Grid></Border>
     <TextBlock Text="IP adresini gizlemez. HTTPS / QUIC desteği vardır; sesli görüşme erişimi ayrıca doğrulanmalıdır." Style="{StaticResource Caption}" FontSize="10" TextAlignment="Center" Margin="0,13,0,0"/>
    </StackPanel>
    <StackPanel x:Name="TargetsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="Yalnızca seçtiğin sitelerde." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Her satıra bir alan adı yaz. Alt alan adları da kapsanır. Değiştirmek için önce bağlantıyı durdur." Style="{StaticResource Caption}" Margin="0,10,0,20"/><TextBox x:Name="HostsEditor" AcceptsReturn="True" Height="315" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="14" AutomationProperties.Name="Hedef siteler"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="SaveHostsButton" Content="Siteleri kaydet" Style="{StaticResource Primary}" Click="SaveHosts_Click"/><Button x:Name="DefaultHostsButton" Content="Varsayılanları getir" Click="Defaults_Click" Margin="12,0,0,0"/></StackPanel></StackPanel></Border></StackPanel>
    <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><StackPanel><TextBlock Text="Tahmin etme. Kontrol et." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Hedef sitelere doğrudan HTTPS testi. Sonuç uygulama girişi veya sesli görüşme garantisi değildir." Style="{StaticResource Caption}" Margin="0,10,0,0" MaxWidth="580" HorizontalAlignment="Left"/></StackPanel><Button x:Name="DiagTestButton" Content="Testi başlat" Click="Test_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid><ItemsControl x:Name="ResultsList" Margin="0,15,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E8EDF5" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Host}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Milliseconds, StringFormat={}{0} ms}" FontSize="12" Foreground="#64758B" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,17,0,0"><StackPanel><Grid><TextBlock Text="Oturum günlüğü" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Klasörü aç" Click="OpenLogs_Click" Padding="12,6" FontSize="11"/><Button Content="Kopyala" Click="CopyLog_Click" Padding="12,6" FontSize="11" Margin="8,0,0,0"/></StackPanel></Grid><TextBlock Text="Günlüklerde alan adları bulunabilir. Paylaşmadan önce incele." Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,12"/><TextBox x:Name="LogBox" IsReadOnly="True" Height="245" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#F8FAFE"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="SilNet, senin kontrolünde." FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Text="SilNet 0.2.0 · Windows x64" Foreground="#2563EB" FontSize="12" Margin="0,10,0,23"/><CheckBox x:Name="AutoUpdatesCheck" Content="Açılışta yeni sürümleri kontrol et" IsChecked="True" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed" FontSize="13"/><TextBlock Text="GitHub’daki resmî SilNet yayınlarını kontrol eder. Yeni sürüm varsa haber verir; iznin olmadan kurulum yapmaz." Style="{StaticResource Caption}" FontSize="12" Margin="20,8,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Güncellemeleri kontrol et" Click="Update_Click"/><Button Content="GitHub’ı aç  ↗" Click="Github_Click" Margin="10,0,0,0"/></StackPanel><Border Height="1" Background="#E7EDF6" Margin="0,25"/><TextBlock Text="Ücretsiz. Hesap ve abonelik gerekmez." FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Trafiğin bize ait bir sunucudan geçmez. Sağlayıcı seçimin ve çalışan ayarlar yalnızca cihazında tutulur. DPI aşımı IP adresini gizlemez. Her ağda çalışması garanti edilmez." Style="{StaticResource Caption}" Margin="0,10,0,18"/><TextBlock Text="Motor ve bağlantı yöntemleri" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Zapret2 (bol-van) · WinDivert (basil00) · Cygwin&#x0a;Türkiye başlangıç profilleri SplitWire-Turkey önayarlarından uyarlanmıştır. Sağlayıcıların resmî ürünü değildir. Lisanslar ve kaynak arşivleri uygulama klasöründedir." Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="DNS, güvenlik duvarı ve otomatik başlangıç ayarları değiştirilmez. Windows yönetici izni bağlantı motoru için istenir. Pencere kapanınca SilNet’in motoru durur." Style="{StaticResource Caption}" FontSize="12" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Margin="0,16,0,0"><ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Foreground="#2563EB" Background="#E3EAF3" Visibility="Collapsed" Margin="0,0,0,11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Notice" Text="Hazır. Sağlayıcını seçip Bağlan’a basabilirsin." FontSize="11" Foreground="#7386A1" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="CancelButton" Content="İptal et" Click="Cancel_Click" Grid.Column="1" Visibility="Collapsed" Padding="12,6" Margin="12,0,0,0" FontSize="11"/></Grid></StackPanel>
 </Grid></Border>
</Window>
